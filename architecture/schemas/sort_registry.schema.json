{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "psk.architecture-register.sort_registry.yaml/1.0",
  "title": "sort_registry.yaml",
  "description": "Strukturschema von architecture/sort_registry.yaml, abgeleitet aus dem verifizierten Registerinhalt (PSK-RA v1.0.3, Struktur 25.3).",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string"
    },
    "count": {
      "type": "integer"
    },
    "sorts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "cell_class": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "owner",
          "cell_class"
        ]
      }
    },
    "port_matrix": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "forbidden_relations": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "domain_supplied_opaque": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "duties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "types": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "meaning": {
                "type": "string"
              },
              "module": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "meaning",
              "module"
            ]
          }
        }
      },
      "required": [
        "source",
        "note",
        "duties",
        "types"
      ]
    },
    "closed_vocabularies": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "source",
              "note",
              "values"
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "values_from": {
                "type": "object",
                "properties": {
                  "register": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  }
                },
                "required": [
                  "register",
                  "path"
                ]
              }
            },
            "required": [
              "id",
              "source",
              "note",
              "values_from"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "schema",
    "count",
    "sorts",
    "port_matrix",
    "forbidden_relations",
    "domain_supplied_opaque",
    "closed_vocabularies"
  ]
}
